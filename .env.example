# Environment variables for Docker Compose
# Copy this file to .env and modify as needed

# Database Configuration
DB_PASSWORD=CHANGE_ME_USE_A_STRONG_DATABASE_PASSWORD
DB_PORT=5432

# API Configuration
API_PORT=8080
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_64_RANDOM_CHARACTERS_FOR_JWT_SIGNING
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:80,http://127.0.0.1:80
ITOP_SWAGGER_ENABLED=false

# Web Configuration
WEB_PORT=80

# Spring Boot Profile
SPRING_PROFILES_ACTIVE=prod

# JVM Options
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# PostgreSQL Settings
POSTGRES_DB=itop
POSTGRES_USER=itop
PGDATA=/var/lib/postgresql/data/pgdata
