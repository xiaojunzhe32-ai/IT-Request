# Environment variables for Docker Compose
# Copy this file to .env and modify as needed

# Database Configuration
DB_PASSWORD=itop123
DB_PORT=5432

# API Configuration
API_PORT=8080
JWT_SECRET=YourSecretKeyForJWTTokenGenerationMustBe256BitsOrLonger_PLEASE_CHANGE_THIS_IN_PRODUCTION
JWT_EXPIRATION=86400000

# Web Configuration
WEB_PORT=80

# Spring Boot Profile
SPRING_PROFILES_ACTIVE=prod

# JVM Options
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# PostgreSQL Settings
POSTGRES_DB=itop
POSTGRES_USER=itop
PGDATA=/var/lib/postgresql/data/pgdata